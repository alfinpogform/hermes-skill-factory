{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "description": "Machine-readable design tokens for the Skill Factory design system. See DESIGN_SYSTEM.md for rationale.",
  "frontmatter": {
    "required": ["name", "version", "category", "description", "tags"],
    "optional": ["author", "generated_by", "generated_at"],
    "order": ["name", "version", "category", "description", "tags", "author", "generated_by", "generated_at"],
    "rules": {
      "name": { "type": "string", "case": "Title Case" },
      "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
      "category": { "type": "string", "case": "kebab-case" },
      "description": { "type": "string", "maxLength": 120, "noTrailingPeriod": true },
      "tags": { "type": "array", "case": "kebab-case", "minItems": 3, "maxItems": 6 },
      "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  },
  "sections": {
    "order": [
      "When to Activate",
      "Workflow",
      "Quality Checklist",
      "Examples",
      "Anti-patterns",
      "Integration"
    ],
    "required": ["When to Activate", "Workflow", "Quality Checklist", "Examples"],
    "optional": ["Anti-patterns", "Integration"]
  },
  "naming": {
    "case": "kebab-case",
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "sanitize": {
      "steps": [
        "lowercase",
        "strip non [a-z0-9\\s-]",
        "collapse [\\s_]+ to -",
        "collapse -+ to -",
        "trim leading/trailing -"
      ]
    },
    "noVersionSuffix": true
  },
  "icons": {
    "brand": "🏭",
    "success": "✅",
    "antiPattern": "❌",
    "bannerRule": "━",
    "bannerRuleLength": 37,
    "checklistUnchecked": "[ ]",
    "checklistChecked": "[x]"
  },
  "shellSeverity": {
    "info": { "ansi": "\\033[0;32m", "name": "green" },
    "warn": { "ansi": "\\033[1;33m", "name": "yellow" },
    "error": { "ansi": "\\033[0;31m", "name": "red", "exitNonZero": true }
  },
  "components": {
    "proposalBanner": {
      "ruleChar": "━",
      "ruleLength": 37,
      "maxConcurrent": 1,
      "labelColumnWidth": 19,
      "fields": ["Proposed Skill", "Category", "Description"],
      "choices": ["A", "B", "C", "D"],
      "recommendedChoice": "C"
    },
    "statusReply": {
      "header": "🏭 **{Title}**",
      "bodyStyle": "flat-bullet-list",
      "footerStyle": "italic-next-action"
    },
    "confirmationReply": {
      "header": "✅ **{message}**",
      "bodyStyle": "file-list"
    },
    "errorReply": {
      "header": "❌ {summary}"
    }
  }
}
